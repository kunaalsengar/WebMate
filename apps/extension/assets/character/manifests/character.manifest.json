{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "name": "shinchan-standard",
  "version": "1.0.0",
  "description": "Layer hierarchy, coordinate anchors, and animation metadata for the Shinchan companion rig.",
  "viewBox": "0 0 200 250",
  "anchors": {
    "shadow": { "x": 100, "y": 240 },
    "torso": { "x": 100, "y": 170 },
    "head": { "x": 100, "y": 115 },
    "leftShoulder": { "x": 70, "y": 135 },
    "rightShoulder": { "x": 130, "y": 135 },
    "leftEyebrow": { "x": 85, "y": 75 },
    "rightEyebrow": { "x": 125, "y": 75 },
    "mouth": { "x": 105, "y": 105 }
  },
  "layers": [
    {
      "id": "layer-shadow",
      "zIndex": 0,
      "anchor": "shadow",
      "description": "Ground drop shadow plane with dynamic scaleX transform."
    },
    {
      "id": "layer-arm-left",
      "zIndex": 10,
      "anchor": "leftShoulder",
      "description": "Background support arm."
    },
    {
      "id": "layer-body",
      "zIndex": 20,
      "anchor": "torso",
      "description": "Torso, red shirt, yellow shorts, legs and shoes."
    },
    {
      "id": "layer-arm-right",
      "zIndex": 30,
      "anchor": "rightShoulder",
      "description": "Foreground articulated arm for waving and 360-degree pointing."
    },
    {
      "id": "layer-head",
      "zIndex": 40,
      "anchor": "head",
      "description": "Base head contour and hair with neck rotational pivot."
    },
    {
      "id": "layer-blush",
      "zIndex": 45,
      "anchor": "head",
      "description": "Cheek blush overlays with dynamic opacity pulse."
    },
    {
      "id": "layer-eyebrows",
      "zIndex": 50,
      "anchor": "head",
      "description": "Thick black eyebrows with independent rotational pivots."
    },
    {
      "id": "layer-eyes",
      "zIndex": 52,
      "anchor": "head",
      "description": "Sclera and pupil layers with procedural squash blinking."
    },
    {
      "id": "layer-mouth",
      "zIndex": 55,
      "anchor": "mouth",
      "dynamic": true,
      "description": "Swappable mouth shape geometries triggered during text streaming."
    },
    {
      "id": "layer-fx",
      "zIndex": 60,
      "anchor": "head",
      "dynamic": true,
      "description": "Emotional FX overlays (Zzz, snot bubble, sweat drop, sparkles)."
    }
  ]
}
