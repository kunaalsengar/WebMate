{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "composite": false,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "paths": {
      "@/*": ["./src/*", "./entrypoints/*"]
    }
  },
  "include": [
    "entrypoints/**/*",
    "src/**/*",
    "wxt.config.ts"
  ]
}
