{
  "name": "webmate-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "WebMate - An interactive AI-powered browser companion extension and backend",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev:extension": "pnpm --filter @webmate/extension dev",
    "dev:backend": "pnpm --filter @webmate/backend dev",
    "build:packages": "pnpm --filter \"@webmate/*\" --filter \"!@webmate/extension\" --filter \"!@webmate/backend\" build",
    "build:backend": "pnpm --filter @webmate/backend build",
    "build:extension": "pnpm --filter @webmate/extension build",
    "build": "pnpm --recursive run build"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
