# ==============================================================================
# WebMate Environment Configuration Template
# Copy this file to '.env' for local development.
#
# WARNING: NEVER commit real API keys, passwords, or credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Server Configuration (@webmate/backend)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
CORS_ORIGIN=chrome-extension://*

# ------------------------------------------------------------------------------
# LLM & AI Service Providers (Planned for Phase 3)
# Leave blank during Phase 0 / Phase 1
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Preferred AI Model Provider: "gemini" | "openai" | "anthropic"
DEFAULT_AI_PROVIDER=gemini

# ------------------------------------------------------------------------------
# Extension Client Configuration (@webmate/extension)
# ------------------------------------------------------------------------------
VITE_BACKEND_URL=http://localhost:4000
